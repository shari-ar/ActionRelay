{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionrelay.local/schemas/result-package.v1.json",
  "title": "ActionRelay Result Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "batch_id",
    "ok",
    "results"
  ],
  "properties": {
    "protocol": {
      "const": "actionrelay.result_package.v1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "ok",
          "response",
          "error"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "response": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "headers",
                  "body",
                  "url",
                  "timing_ms"
                ],
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "data",
                      "bytes",
                      "truncated"
                    ],
                    "properties": {
                      "encoding": {
                        "type": "string"
                      },
                      "data": {
                        "type": "string"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "truncated": {
                        "type": "boolean"
                      }
                    }
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timing_ms": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
